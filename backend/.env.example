# Copy to .env and fill in. Only DATABASE_URL is required; everything else shows its default.

# Neon Postgres, pooled endpoint (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=verify-full&channel_binding=require
# Direct endpoint, for running migrations only.
DATABASE_URL_UNPOOLED=

# development | production | test
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Dashboard origins allowed to call the API from another domain, comma-separated.
# Leave empty when a proxy serves the dashboard and /api from one origin.
CORS_ORIGINS=

# Proxy hops in front of the API (load balancer / platform router). Defaults: 1 in production, 0 otherwise.
TRUST_PROXY=

# Per-instance database pool. Keep instances × DB_POOL_MAX within Neon's pooler limits.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000

# Requests per client IP per window, across /api. Offices share IPs, so keep this generous.
RATE_LIMIT_MAX=3000
RATE_LIMIT_WINDOW_MS=60000

# Summary results are shared between users for this long (0 turns caching off).
SUMMARY_CACHE_TTL_MS=30000

# Quotation uploads (local disk storage).
UPLOAD_DIR=data/uploads
UPLOAD_MAX_BYTES=20971520
