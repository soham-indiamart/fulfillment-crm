# Copy to .env.local for local development. Nothing here is secret: VITE_* values end up in the browser.

# Where `npm run dev` and `npm run preview` forward /api and /uploads (the backend).
BACKEND_URL=http://localhost:8080

# Build-time backend origin. Leave empty when /api is served from the dashboard's own origin
# (the nginx image, or a CDN routing /api to the backend). Set it for a separate API domain,
# and add the dashboard's origin to the backend's CORS_ORIGINS.
VITE_API_BASE_URL=
